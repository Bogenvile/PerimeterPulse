# PerimeterPulse — Environment Variables

# PostgreSQL
PG_PASSWORD=perimeterpulse

# InfluxDB
INFLUX_USER=admin
INFLUX_PASSWORD=perimeterpulse
INFLUX_ORG=perimeterpulse
INFLUX_BUCKET=perimeterpulse
INFLUX_TOKEN=perimeterpulse-token

# Backend
DATABASE_URL=postgresql://perimeterpulse:perimeterpulse@localhost:5432/perimeterpulse
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=perimeterpulse-token
INFLUXDB_ORG=perimeterpulse
INFLUXDB_BUCKET=perimeterpulse
