# PerimeterPulse — Environment Variables (MySQL)

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=perimeterpulse
MYSQL_PASSWORD=perimeterpulse
MYSQL_DATABASE=perimeterpulse
DATABASE_URL=mysql://perimeterpulse:perimeterpulse@localhost:3306/perimeterpulse

# InfluxDB
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=perimeterpulse-token
INFLUXDB_ORG=perimeterpulse
INFLUXDB_BUCKET=perimeterpulse

# JWT Secret (change in production!)
NITRO_JWT_SECRET=perimeterpulse-jwt-secret-change-in-production
